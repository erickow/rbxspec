{
  "name": "rbxspec",
  "version": "0.1.0",
  "description": "rbxspec is the smallest spec-driven development toolkit for Roblox games, solo devs, and AI agents",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --project tsconfig.json && node scripts/copy-prompts.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "rbxspec",
    "roblox",
    "roblox-ts",
    "luau",
    "spec",
    "sdd",
    "ai",
    "claude",
    "gemini",
    "cursor",
    "opencode",
    "antigravity",
    "kilo"
  ],
  "author": "RobloxUI",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "enquirer": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "bin": {
    "rbxspec": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erickow/rbxspec.git"
  },
  "bugs": {
    "url": "https://github.com/erickow/rbxspec/issues"
  },
  "homepage": "https://github.com/erickow/rbxspec#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ]
}
